{
    "version": 2,
    "functions": {
        "api/health.ts": {
            "maxDuration": 10
        },
        "api/trpc/[...path].ts": {
            "maxDuration": 30
        },
        "api/cron/health.ts": {
            "maxDuration": 60
        }
    },
    "crons": [
        {
            "path": "/api/cron/health",
            "schedule": "0 6 * * *"
        }
    ]
}
