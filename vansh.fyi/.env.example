# Copy to .env.local (gitignored). Used by the site, the /api routes and the scripts.
# Only variables prefixed NEXT_PUBLIC_ reach the browser: never put a secret behind that prefix.

# --- Supabase (knowledge base + rate limits) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Needed for ingest and rate limiting; chat fails closed if the limiter is unavailable
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for the `embed` Edge Function (must match `supabase secrets set EMBED_SECRET=...`)
EMBED_SECRET=

# --- Chat fallback order: Gemini -> Groq -> OpenRouter. ---
# Configure at least one key; all three enable the full chain.
# Use free-tier Gemini/Groq accounts without paid billing to require zero model spend.
GEMINI_API_KEY=
GROQ_API_KEY=
# Only explicit :free model variants are allowed through OpenRouter.
OPENROUTER_API_KEY=

# --- Email (lead form + health alerts) ---
RESEND_API_KEY=
CONTACT_EMAIL=

# --- Admin (/admin) ---
# The one email address allowed to sign in. Create that user in Supabase > Authentication > Users
# (email + password, auto-confirm on), then turn OFF "Allow new users to sign up".
ADMIN_EMAIL=

# --- Production ---
# Authorises Vercel Cron to call /api/cron/health (any long random string)
CRON_SECRET=
# Optional: comma-separated tables the health check queries to keep Supabase from pausing
KEEPALIVE_TABLES=
# Optional: canonical origin for metadata, sitemap and robots (default https://portfolio.vansh.fyi)
NEXT_PUBLIC_SITE_URL=
