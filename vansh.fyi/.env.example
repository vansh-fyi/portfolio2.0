# Copy to .env.local (gitignored). Used by the site, the /api routes and the scripts.
# Only variables prefixed NEXT_PUBLIC_ reach the browser: never put a secret behind that prefix.

# --- Supabase (knowledge base + rate limits) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Needed for ingest and rate limiting; without it the rate limiter silently allows everything
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for the `embed` Edge Function (must match `supabase secrets set EMBED_SECRET=...`)
EMBED_SECRET=

# --- LLM providers: set at least one. Use free-tier keys with NO billing attached. ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Email (lead form + health alerts) ---
RESEND_API_KEY=
CONTACT_EMAIL=

# --- Production ---
# Authorises Vercel Cron to call /api/cron/health (any long random string)
CRON_SECRET=
# Optional: comma-separated tables the health check queries to keep Supabase from pausing
KEEPALIVE_TABLES=
# Optional: canonical origin for metadata, sitemap and robots (default https://portfolio.vansh.fyi)
NEXT_PUBLIC_SITE_URL=
